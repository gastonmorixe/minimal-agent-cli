{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "extends": ["@minimal-agent/config/biome"],
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "src/**",
      "scripts/compile.ts",
      "scripts/computer-use-helper.ts",
      "scripts/computer-use-helper.test.ts",
      "scripts/gen-embedded-plugins.ts",
      "scripts/gen-embedded-plugins.test.ts",
      "scripts/release/**",
      "package.json",
      "tsconfig.json",
      "biome.json",
      ".oxlintrc.json"
    ]
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on"
        }
      }
    }
  }
}
