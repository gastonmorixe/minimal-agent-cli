{
  "name": "minimal-agent-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "The terminal and process host for minimal-agent.",
  "homepage": "https://github.com/gastonmorixe/minimal-agent-cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gastonmorixe/minimal-agent-cli.git"
  },
  "bin": {
    "minimal-agent": "src/index.ts"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@minimal-agent/core": "git+ssh://git@github.com/gastonmorixe/minimal-agent-core.git#9b8f9a0a0d1e25b3dc04c98eb43298e48ff5d0e1"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun run architecture:preflight && bun test",
    "test:e2e": "E2E=1 bun test",
    "architecture:preflight": "bun run src/architecture/node-preflight.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "imports": "biome check --write --formatter-enabled=false --linter-enabled=false .",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run biome:check && bun run test",
    "prepare": "husky",
    "commitlint": "commitlint",
    "commitlint:last": "commitlint --last --verbose"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "bun-types": "^1.3.14",
    "eslint-plugin-jsdoc": "^63.0.12",
    "eslint-plugin-tsdoc": "^0.5.2",
    "husky": "^9.1.7",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "brace-expansion": "^5.0.6"
  }
}
