{
  "name": "minimal-agent-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "The terminal and process host for minimal-agent.",
  "homepage": "https://github.com/gastonmorixe/minimal-agent-cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gastonmorixe/minimal-agent-cli.git"
  },
  "bin": {
    "minimal-agent": "src/index.ts"
  },
  "imports": {
    "#embedded-plugins": "./src/generated/embedded-plugins.empty.ts"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@minimal-agent/core": "git+ssh://git@github.com/gastonmorixe/minimal-agent-core.git#51acc12d43f0a8ff653da807bfdbc0cf7c1e2e91"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "compile:dev": "bun run scripts/compile.ts --mode dev",
    "compile:release": "bun run scripts/compile.ts --mode release",
    "compile:release:all": "bun run scripts/compile.ts --mode release --all",
    "test": "bun run architecture:preflight && bun test",
    "test:e2e": "E2E=1 bun test",
    "architecture:preflight": "bun run src/architecture/node-preflight.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "imports": "biome check --write --formatter-enabled=false --linter-enabled=false .",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run biome:check && bun run test",
    "prepare": "husky",
    "commitlint": "commitlint",
    "commitlint:last": "commitlint --last --verbose"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@minimal-agent/config": "git+ssh://git@github.com/gastonmorixe/minimal-agent-config.git#577f271190af924af7806daedcb39c5134b7b2ce",
    "bun-types": "^1.4.4",
    "eslint-plugin-jsdoc": "^65.4.5",
    "eslint-plugin-tsdoc": "^0.5.4",
    "husky": "^9.1.7",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2"
  },
  "overrides": {
    "brace-expansion": "^5.0.6"
  }
}
