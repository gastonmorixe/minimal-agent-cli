exports[`command help: usage COLUMNS=80, NO_COLOR=1 1`] = `
"  minimal-agent usage
    Show token usage stats for a period
    Alias: --usage-stats.

  USAGE
    minimal-agent usage [<period>]

  ARGUMENTS
    period  Time window of the stats (one of: today, last-day, last-month, ytd,
            year, all)

  GLOBAL FLAGS
    See minimal-agent --help for all global flags.
    -h, --help   Show help
    -d, --debug  Enable debug logging
"
`;

