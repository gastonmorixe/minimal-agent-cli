// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`command help: providers COLUMNS=80, NO_COLOR=1 1`] = `
"  minimal-agent providers
    List registered providers
    Aliases: --list-providers, --providers.

  USAGE
    minimal-agent providers [list]
    minimal-agent providers <command> [args] [flags]

  COMMANDS
    list         List registered providers
    models       List registered models (offline, no network)
    models-live  List live provider catalogs (network)
    login <id>   Sign in to a provider
    logout <id>  Clear one provider's credentials

  GLOBAL FLAGS
    See minimal-agent --help for all global flags.
    -h, --help   Show help
    -d, --debug  Enable debug logging
"
`;

