exports[`command help: auth-status plan COLUMNS=80, NO_COLOR=1 1`] = `
"  minimal-agent auth-status plan
    Show plan, seat, role, and usage limits (spends no quota)

  USAGE
    minimal-agent auth-status plan [<credential>] [--all] [--table]
      [--parallel <n>]

  ARGUMENTS
    credential  Only this credential (name, label, or provider id)

  FLAGS
    --all           Keep rows for credentials with no plan lookup
    --table         Print a Markdown pipe table instead of the human rows
    --parallel <n>  Max parallel workers (max 8) (default: 4)
    --name <n>      Credential name, in place of the positional credential

  GLOBAL FLAGS
    See minimal-agent --help for all global flags.
    -h, --help   Show help
    -d, --debug  Enable debug logging
"
`;

