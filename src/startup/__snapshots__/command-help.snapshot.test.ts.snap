exports[`command help: auth-status COLUMNS=80, NO_COLOR=1 1`] = `
"  minimal-agent auth-status
    Show login status, account, scopes, and expiry

  USAGE
    minimal-agent auth-status [--table]
    minimal-agent auth-status <command> [args] [flags]

  COMMANDS
    refresh      Refresh one stored OAuth credential
    refresh-all  Refresh all stored OAuth credentials (max 8)
    plan         Show plan, seat, role, and usage limits (spends no quota)
    prune        Delete stored credentials the server rejects (dry run lists
                 only)

  FLAGS
    --table  Print a Markdown pipe table instead of the human rows

  GLOBAL FLAGS
    See minimal-agent --help for all global flags.
    -h, --help   Show help
    -d, --debug  Enable debug logging
"
`;

exports[`command help: auth-status COLUMNS=120, NO_COLOR=1 1`] = `
"  minimal-agent auth-status
    Show login status, account, scopes, and expiry

  USAGE
    minimal-agent auth-status [--table]
    minimal-agent auth-status <command> [args] [flags]

  COMMANDS
    refresh      Refresh one stored OAuth credential
    refresh-all  Refresh all stored OAuth credentials (max 8)
    plan         Show plan, seat, role, and usage limits (spends no quota)
    prune        Delete stored credentials the server rejects (dry run lists only)

  FLAGS
    --table  Print a Markdown pipe table instead of the human rows

  GLOBAL FLAGS
    See minimal-agent --help for all global flags.
    -h, --help   Show help
    -d, --debug  Enable debug logging
"
`;

exports[`command help: auth-status refresh COLUMNS=80, NO_COLOR=1 1`] = `
"  minimal-agent auth-status refresh
    Refresh one stored OAuth credential

  USAGE
    minimal-agent auth-status <credential> refresh [--name <n>] [--provider
      <id>]

  ARGUMENTS
    credential  Credential name, label, or provider id

  FLAGS
    --name <n>       Credential name, in place of the positional credential
    --provider <id>  Select the provider for --model. Else the env value, then
                     the config key provider.

  GLOBAL FLAGS
    See minimal-agent --help for all global flags.
    -h, --help   Show help
    -d, --debug  Enable debug logging

  ENVIRONMENT
    MINIMAL_AGENT_PROVIDER  Default provider id (flag: --provider)
"
`;

exports[`command help: auth-status refresh COLUMNS=120, NO_COLOR=1 1`] = `
"  minimal-agent auth-status refresh
    Refresh one stored OAuth credential

  USAGE
    minimal-agent auth-status <credential> refresh [--name <n>] [--provider <id>]

  ARGUMENTS
    credential  Credential name, label, or provider id

  FLAGS
    --name <n>       Credential name, in place of the positional credential
    --provider <id>  Select the provider for --model. Else the env value, then the config key provider.

  GLOBAL FLAGS
    See minimal-agent --help for all global flags.
    -h, --help   Show help
    -d, --debug  Enable debug logging

  ENVIRONMENT
    MINIMAL_AGENT_PROVIDER  Default provider id (flag: --provider)
"
`;

exports[`command help: auth-status refresh-all COLUMNS=80, NO_COLOR=1 1`] = `
"  minimal-agent auth-status refresh-all
    Refresh all stored OAuth credentials (max 8)

  USAGE
    minimal-agent auth-status refresh-all [--parallel <n>]

  FLAGS
    --parallel <n>  Max parallel workers (max 8) (default: 4)

  GLOBAL FLAGS
    See minimal-agent --help for all global flags.
    -h, --help   Show help
    -d, --debug  Enable debug logging
"
`;

