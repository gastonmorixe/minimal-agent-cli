exports[`command help: resume COLUMNS=80, NO_COLOR=1 1`] = `
"  minimal-agent resume
    Resume a saved session
    Also: sessions resume <sid>. Aliases: -r, --resume.
    It reuses the credential pin only when the provider matches the session.

  USAGE
    minimal-agent resume <sid|last>

  ARGUMENTS
    sid  Session id, or last for the newest session

  GLOBAL FLAGS
    See minimal-agent --help for all global flags.
    -h, --help   Show help
    -d, --debug  Enable debug logging
"
`;

