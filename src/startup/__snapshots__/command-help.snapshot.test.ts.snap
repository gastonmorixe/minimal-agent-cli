exports[`command help: plugins COLUMNS=80, NO_COLOR=1 1`] = `
"  minimal-agent plugins
    List installed plugins and their on or off state
    Aliases: --list-plugins, --plugins.

  USAGE
    minimal-agent plugins [list]
    minimal-agent plugins <command> [args] [flags]

  COMMANDS
    list  List installed plugins and their on or off state

  FLAGS
    --disable-plugin <id>  Skip a plugin for this run, repeatable. A
                           comma-separated list is also accepted. See plugins
                           list.
    --enable-plugin <id>   Force-enable a plugin for this run, repeatable.
                           Overrides the config and the manifest opt-out.

  GLOBAL FLAGS
    See minimal-agent --help for all global flags.
    -h, --help   Show help
    -d, --debug  Enable debug logging

  ENVIRONMENT
    MINIMAL_AGENT_DISABLE_PLUGINS  Comma-separated plugin ids to skip this run
                                   (flag: --disable-plugin)
    MINIMAL_AGENT_ENABLE_PLUGINS   Comma-separated plugin ids to force on this
                                   run (flag: --enable-plugin)
"
`;

