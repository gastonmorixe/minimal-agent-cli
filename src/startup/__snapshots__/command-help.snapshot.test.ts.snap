exports[`command help: providers models COLUMNS=80, NO_COLOR=1 1`] = `
"  minimal-agent providers models
    List registered models (offline, no network)
    Also: models [list], provider <id> models.
    Aliases: --list-models, --models.

  USAGE
    minimal-agent providers models [<id>]

  ARGUMENTS
    id  Only this provider

  FLAGS
    --print-format <text|json|md|xml>  Output shape for providers models
                                       (default: text). The values tui, console,
                                       and stdout mean text.

  GLOBAL FLAGS
    See minimal-agent --help for all global flags.
    -h, --help   Show help
    -d, --debug  Enable debug logging

  ENVIRONMENT
    MINIMAL_AGENT_PRINT_FORMAT  Same as --print-format
"
`;

