exports[`command help: sessions dump COLUMNS=80, NO_COLOR=1 1`] = `
"  minimal-agent sessions dump
    Dump a full session history to stdout
    Alias: --dump <sid|last>.

  USAGE
    minimal-agent sessions dump <sid|last>

  ARGUMENTS
    sid  Session id, or last for the newest session

  FLAGS
    --dump-format <md|xml>  Output format of the dump (default: md)
    --dump-paths            Also print the paths of the session files

  GLOBAL FLAGS
    See minimal-agent --help for all global flags.
    -h, --help   Show help
    -d, --debug  Enable debug logging
"
`;

exports[`command help: sessions dump COLUMNS=120, NO_COLOR=1 1`] = `
