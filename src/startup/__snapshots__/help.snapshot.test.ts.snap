// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`root help snapshot COLUMNS=80, NO_COLOR=1: wrapped to 80, no color 1`] = `
"  minimal-agent v<AGENT_VERSION>
    A small, inspectable terminal agent harness.

  USAGE
    minimal-agent [flags] [prompt]
    minimal-agent <command> [args] [flags]

  EXAMPLES
    minimal-agent    Start the interactive REPL
    minimal-agent "explain this codebase"
                     Run one prompt, then exit
    minimal-agent -  Read the prompt from stdin

  COMMANDS
    Discover
      providers  List registered providers
    History
      sessions           List saved sessions
      usage              Show token usage stats for a period
      resume <sid>       Resume a saved session
      resume-same <sid>  Resume in place, keeping the same session id
    Auth
      provider <id>  Act on one provider
      login          Sign in to a provider
      logout         Clear one provider's credentials
      auth-status    Show login status, account, scopes, and expiry
    Local
      plugins   List installed plugins and their on or off state
      flags     Show beta feature flags
      spinners  Show available spinner presets
      help      Show help for a command

  FLAGS
    Model
      -m, --model <id>           Select the model (env: MINIMAL_AGENT_MODEL)
      --provider <id>            Select the provider for --model (env:
                                 MINIMAL_AGENT_PROVIDER)
      -e, --effort <level>       Reasoning effort: low, medium, high, xhigh, max
                                 (env: MINIMAL_AGENT_EFFORT)
      -F, --fast                 Fast-mode dispatch on fast-capable models (env:
                                 MINIMAL_AGENT_FAST)
      --thinking-display <mode>  Force the thinking display mode (one of:
                                 summarized, omitted; env:
                                 MINIMAL_AGENT_THINKING_DISPLAY)
      --cache-ttl <5m|1h>        Prompt-cache breakpoint TTL (default: 5m; env:
                                 MINIMAL_AGENT_CACHE_TTL)
      --service-tier <tier>      Provider service tier: auto, default, flex,
                                 scale, priority (env:
                                 MINIMAL_AGENT_SERVICE_TIER)
      --credential-name <name>   Select a stored credential by name (env:
                                 MINIMAL_AGENT_CREDENTIAL_NAME)
    Generic endpoint
      --endpoint <url>          Generic endpoint URL (env:
                                MINIMAL_AGENT_ENDPOINT)
      --format, --surface <id>  Generic endpoint wire surface (env:
                                MINIMAL_AGENT_FORMAT)
      --auth-type <type>        Generic endpoint auth type (one of: api-key,
                                bearer, none, custom-header; env:
                                MINIMAL_AGENT_AUTH_TYPE)
      --api-key <key>           Generic endpoint key or token (env:
                                MINIMAL_AGENT_API_KEY)
      --auth-header <name>      Auth header name for --auth-type custom-header
                                (env: MINIMAL_AGENT_AUTH_HEADER)
      --provider-model <id>     Wire model id override (env:
                                MINIMAL_AGENT_PROVIDER_MODEL)
      --effort-levels <levels>  Generic endpoint effort ladder, comma-separated
                                (env: MINIMAL_AGENT_EFFORT_LEVELS)
    Output
      -p, --prompt <text>      Non-interactive: send the prompt, print, exit
      --output-format <text|json|stream-json>
                               Non-interactive output format, --json is short
                               for json (default: text)
      --diagnostics            With --output-format json, also write diagnostics
      --output-schema <file>   Constrain the final answer to a JSON Schema
      -f, --formatter <cmd>    Pipe output through a formatter command (default:
                               mdstream)
      --formatter-args <args>  Extra formatter args, for example --table-fit
                               (env: MINIMAL_AGENT_FORMATTER_ARGS)
      -s, --spinner <preset>   Pick a status spinner preset, see spinners (env:
                               MINIMAL_AGENT_SPINNER)
      --header / --no-header   Force the startup tree on or off (env:
                               MINIMAL_AGENT_HEADER)
      --no-color               Print help with no color, as do NO_COLOR and
                               TERM=dumb
      --show-hidden-chars      Show spaces, tabs, and newlines as faint glyphs
                               (env: MINIMAL_AGENT_SHOW_HIDDEN_CHARS)
    Tools and modes
      --mode <id|none>  Initial mode id, or none (env: MINIMAL_AGENT_MODE)
      --tools <names>   Advertise only these tools, comma-separated
      --no-tools        Advertise no tools, for pure Q&A
    Plugins
      --disable-plugin <id>        Skip a plugin for this run, repeatable (env:
                                   MINIMAL_AGENT_DISABLE_PLUGINS)
      --enable-plugin <id>         Force-enable a plugin for this run,
                                   repeatable (env:
                                   MINIMAL_AGENT_ENABLE_PLUGINS)
      --no-agents-md, --no-agents  Skip AGENTS.md injection, same as
                                   --disable-plugin agents-md (env:
                                   MINIMAL_AGENT_NO_AGENTS_MD)
      --platform <os>              Override the platform for plugin and tool
                                   gating (one of: macos, linux, windows, all;
                                   env: MINIMAL_AGENT_PLATFORM)
      --host-mode <id>             Hand the process to a plugin host mode, for
                                   example acp
    Session
      --session-id <uuid>  Pin the session id of this run (env:
                           MINIMAL_AGENT_SESSION_ID)
    System prompt (override or omit individual system-prompt parts)
      --system-prompt <text>            Replace the whole core-controllable
                                        system prompt (also --system-prompt-file
                                        <path>, --no-system-prompt; env:
                                        MINIMAL_AGENT_SYSTEM_PROMPT)
      --system-identity <text>          Replace the neutral identity block (also
                                        --system-identity-file <path>,
                                        --no-system-identity; env:
                                        MINIMAL_AGENT_SYSTEM_IDENTITY)
      --system-instructions <text>      Replace the base instructions block
                                        (also --system-instructions-file <path>,
                                        --no-system-instructions; env:
                                        MINIMAL_AGENT_SYSTEM_INSTRUCTIONS)
      --system-loop-safety <text>       Replace the loop-safety paragraph (also
                                        --system-loop-safety-file <path>,
                                        --no-system-loop-safety; env:
                                        MINIMAL_AGENT_SYSTEM_LOOP_SAFETY)
      --system-tool-output-conventions <text>
          Replace the tool-output-conventions paragraph (also
          --system-tool-output-conventions-file <path>,
          --no-system-tool-output-conventions; env:
          MINIMAL_AGENT_SYSTEM_TOOL_OUTPUT_CONVENTIONS)
      --system-session-context <text>   Replace the session-context block of
                                        plugin prompts (also
                                        --system-session-context-file <path>,
                                        --no-system-session-context; env:
                                        MINIMAL_AGENT_SYSTEM_SESSION_CONTEXT)
      --provider-system-preamble <text>
                                        Replace the provider preamble, needs
                                        --unsafe-system-prompt-overrides (also
                                        --provider-system-preamble-file <path>,
                                        --no-provider-system-preamble; env:
                                        MINIMAL_AGENT_PROVIDER_SYSTEM_PREAMBLE)
      --unsafe-system-prompt-overrides  Allow a provider preamble override or
                                        omission
    Debug
      -d, --debug    Enable debug logging (env: DEBUG)
      -v, --verbose  Do not truncate debug output (env: VERBOSE)
      --skip-quota   Skip the startup quota check (env:
                     MINIMAL_AGENT_SKIP_QUOTA)
    Help
      -h, --help  Show help

  ENVIRONMENT
    DEBUG                               Verbose request and response debug
                                        diagnostics (set to 1; flag: --debug)
    MINIMAL_AGENT_LOG_STDERR            Mirror every diagnostic to stderr (set
                                        to 1)
    MINIMAL_AGENT_TRANSPORT             Transport: http2 or fetch (default:
                                        http2)
    MINIMAL_AGENT_NO_PLAINTEXT_HTTP1    Keep http:// on HTTP/2, no plaintext
                                        auto-route (set to 1)
    MINIMAL_AGENT_ALLOW_FETCH_FALLBACK  Allow fetch fallback after HTTP/2
                                        failure (set to 1)
    MINIMAL_AGENT_NET_DBG               Mirror raw HTTP traffic to
                                        ~/.minimal-agent/net-dbg/ (set to 1)
    CLAUDE_CODE_EXTRA_METADATA          JSON object merged into metadata.user_id
    MINIMAL_AGENT_SPINNER               Spinner preset id (flag: --spinner)
    MINIMAL_AGENT_EFFORT                Reasoning effort (flag: --effort)
    MINIMAL_AGENT_FAST                  Opt into fast-mode dispatch (set to 1;
                                        flag: --fast)
    MINIMAL_AGENT_THINKING_DISPLAY      Force the thinking display mode (flag:
                                        --thinking-display)
    MINIMAL_AGENT_FORMATTER_ARGS        Extra formatter args, shell-style (flag:
                                        --formatter-args)
    MINIMAL_AGENT_CONFIG                Override the config path (default:
                                        ~/.minimal-agent/config.jsonc)
    MINIMAL_AGENT_MODEL                 Default model id (flag: --model)
    MINIMAL_AGENT_PROVIDER              Default provider id (flag: --provider)
    MINIMAL_AGENT_ENDPOINT              Generic endpoint URL (flag: --endpoint)
    MINIMAL_AGENT_FORMAT                Generic endpoint surface id (flag:
                                        --format)
    MINIMAL_AGENT_AUTH_TYPE             Generic endpoint auth type (flag:
                                        --auth-type)
    MINIMAL_AGENT_API_KEY               Generic endpoint key or token (flag:
                                        --api-key)
    MINIMAL_AGENT_AUTH_HEADER           Custom auth header name (flag:
                                        --auth-header)
    MINIMAL_AGENT_PROVIDER_MODEL        Wire model id override (flag:
                                        --provider-model)
    MINIMAL_AGENT_EFFORT_LEVELS         Generic endpoint effort ladder,
                                        comma-separated (flag: --effort-levels)
    MINIMAL_AGENT_MEMORY_NAMESPACE      Namespace memory paths under
                                        namespaces/<ns>/
    MINIMAL_AGENT_THEME                 UI theme: dark, light, or high-contrast
    MINIMAL_AGENT_NO_LIVE_AREA          Disable the live-area REPL (set to 1)
    MINIMAL_AGENT_HEADER                Force the startup tree: 0 or 1 (flag:
                                        --header)
    MINIMAL_AGENT_MODE                  Initial mode id, or none (flag: --mode)
    MINIMAL_AGENT_CONTINUATION_PROMPT   Override the continuation-prompt prefix
                                        (default: " ")
    MINIMAL_AGENT_SHOW_HIDDEN_CHARS     Show spaces, tabs, and newlines as faint
                                        glyphs (set to 1; flag:
                                        --show-hidden-chars)
    MINIMAL_AGENT_SKIP_QUOTA            Skip the startup quota check (set to 1;
                                        flag: --skip-quota)
    MINIMAL_AGENT_NO_PLUGIN_SYNC        Skip the first-run extended-plugins
                                        clone (set to 1)
    MINIMAL_AGENT_PLUGIN_SIBLINGS       Dev plugin checkout dirs,
                                        colon-separated
    MINIMAL_AGENT_AUTO_ASK              Turn off automatic ASK mode in the REPL
                                        (set to 0)
    MINIMAL_AGENT_AUTO_COMPACT          Turn off auto compact on a context
                                        overflow (set to 0)
    MINIMAL_AGENT_DISABLE_PLUGINS       Comma-separated plugin ids to skip this
                                        run (flag: --disable-plugin)
    MINIMAL_AGENT_ENABLE_PLUGINS        Comma-separated plugin ids to force on
                                        this run (flag: --enable-plugin)
    MINIMAL_AGENT_NO_AGENTS_MD          Skip AGENTS.md system-prompt injection
                                        (set to 1; flag: --no-agents-md)
    MINIMAL_AGENT_PLUGINS_REPO          Git URL of the extended plugins repo,
                                        for a fork or mirror
    MINIMAL_AGENT_GITHUB_TOKEN          Token to clone a private plugins repo,
                                        else GITHUB_TOKEN, GH_TOKEN, gh
    MINIMAL_AGENT_NO_HISTORY            Disable prompt history (set to 1)
    MINIMAL_AGENT_FILE_LOCK_DISABLED    Disable cooperative file locking (set to
                                        1)
    MINIMAL_AGENT_SUBAGENT_MODEL        Force a model for spawned workers
    MINIMAL_AGENT_SUBAGENT_AUTO_TIER    Let specialists pick a per-role model
                                        (set to 1)
    MINIMAL_AGENT_SYSTEM_*              Override system-prompt parts, see the
                                        System prompt flags

  PLUGIN NOTES
    Enable and disable precedence: CLI → env → config → manifest.
    List              minimal-agent plugins list
    One-shot disable  minimal-agent --disable-plugin web-search -p "…"
    Disable many      minimal-agent --disable-plugin web-search,memory
    One-shot enable   minimal-agent --enable-plugin interleave-thinking
    Persistent        { "plugins": { "<id>": { "enabled": false } } }
    Opt in            { "plugins": { "<id>": { "enabled": true } } } (for
                      plugins shipped disabled)
    Built-in          ask-mode, config, diff-view, env-info, file-lock,
                      history, memory, model-info, quota-status, schedule,
                      session-info, sub-agents, tasks, usage, web-search
    Disabled          interleave-thinking, security, minimal-agent-cloud (opt in
                      to use, see Opt in above)

  LEARN MORE
    Use minimal-agent help <command> for command help.
    minimal-agent --help --json prints this help as JSON
    github.com/gastonmorixe/minimal-agent
    CHANGELOG.md                    CLI release notes, newest first
                                    (minimal-agent-cli repo)
    docs/tui/                       Terminal renderer architecture (compositor,
                                    live area, editor)
    core docs/CHANGELOG.md          Core release notes (minimal-agent-core repo)
    core docs/network/              HTTP transport, retry, and wire-capture
                                    notes
    core docs/sub-agents-prompt.md  How the sub-agents system prompt composes
    core docs/changes/              Per-change write-ups, dated
"
`;

exports[`root help snapshot COLUMNS=120, NO_COLOR=1: wrapped to 120, no color 1`] = `
"  minimal-agent v<AGENT_VERSION>
    A small, inspectable terminal agent harness.

  USAGE
    minimal-agent [flags] [prompt]
    minimal-agent <command> [args] [flags]

  EXAMPLES
    minimal-agent                          Start the interactive REPL
    minimal-agent "explain this codebase"  Run one prompt, then exit
    minimal-agent -                        Read the prompt from stdin

  COMMANDS
    Discover
      providers  List registered providers
    History
      sessions           List saved sessions
      usage              Show token usage stats for a period
      resume <sid>       Resume a saved session
      resume-same <sid>  Resume in place, keeping the same session id
    Auth
      provider <id>  Act on one provider
      login          Sign in to a provider
      logout         Clear one provider's credentials
      auth-status    Show login status, account, scopes, and expiry
    Local
      plugins   List installed plugins and their on or off state
      flags     Show beta feature flags
      spinners  Show available spinner presets
      help      Show help for a command

  FLAGS
    Model
      -m, --model <id>           Select the model (env: MINIMAL_AGENT_MODEL)
      --provider <id>            Select the provider for --model (env: MINIMAL_AGENT_PROVIDER)
      -e, --effort <level>       Reasoning effort: low, medium, high, xhigh, max (env: MINIMAL_AGENT_EFFORT)
      -F, --fast                 Fast-mode dispatch on fast-capable models (env: MINIMAL_AGENT_FAST)
      --thinking-display <mode>  Force the thinking display mode (one of: summarized, omitted; env:
                                 MINIMAL_AGENT_THINKING_DISPLAY)
      --cache-ttl <5m|1h>        Prompt-cache breakpoint TTL (default: 5m; env: MINIMAL_AGENT_CACHE_TTL)
      --service-tier <tier>      Provider service tier: auto, default, flex, scale, priority (env:
                                 MINIMAL_AGENT_SERVICE_TIER)
      --credential-name <name>   Select a stored credential by name (env: MINIMAL_AGENT_CREDENTIAL_NAME)
    Generic endpoint
      --endpoint <url>          Generic endpoint URL (env: MINIMAL_AGENT_ENDPOINT)
      --format, --surface <id>  Generic endpoint wire surface (env: MINIMAL_AGENT_FORMAT)
      --auth-type <type>        Generic endpoint auth type (one of: api-key, bearer, none, custom-header; env:
                                MINIMAL_AGENT_AUTH_TYPE)
      --api-key <key>           Generic endpoint key or token (env: MINIMAL_AGENT_API_KEY)
      --auth-header <name>      Auth header name for --auth-type custom-header (env: MINIMAL_AGENT_AUTH_HEADER)
      --provider-model <id>     Wire model id override (env: MINIMAL_AGENT_PROVIDER_MODEL)
      --effort-levels <levels>  Generic endpoint effort ladder, comma-separated (env: MINIMAL_AGENT_EFFORT_LEVELS)
    Output
      -p, --prompt <text>                      Non-interactive: send the prompt, print, exit
      --output-format <text|json|stream-json>  Non-interactive output format, --json is short for json (default: text)
      --diagnostics                            With --output-format json, also write diagnostics
      --output-schema <file>                   Constrain the final answer to a JSON Schema
      -f, --formatter <cmd>                    Pipe output through a formatter command (default: mdstream)
      --formatter-args <args>                  Extra formatter args, for example --table-fit (env:
                                               MINIMAL_AGENT_FORMATTER_ARGS)
      -s, --spinner <preset>                   Pick a status spinner preset, see spinners (env: MINIMAL_AGENT_SPINNER)
      --header / --no-header                   Force the startup tree on or off (env: MINIMAL_AGENT_HEADER)
      --no-color                               Print help with no color, as do NO_COLOR and TERM=dumb
      --show-hidden-chars                      Show spaces, tabs, and newlines as faint glyphs (env:
                                               MINIMAL_AGENT_SHOW_HIDDEN_CHARS)
    Tools and modes
      --mode <id|none>  Initial mode id, or none (env: MINIMAL_AGENT_MODE)
      --tools <names>   Advertise only these tools, comma-separated
      --no-tools        Advertise no tools, for pure Q&A
    Plugins
      --disable-plugin <id>        Skip a plugin for this run, repeatable (env: MINIMAL_AGENT_DISABLE_PLUGINS)
      --enable-plugin <id>         Force-enable a plugin for this run, repeatable (env: MINIMAL_AGENT_ENABLE_PLUGINS)
      --no-agents-md, --no-agents  Skip AGENTS.md injection, same as --disable-plugin agents-md (env:
                                   MINIMAL_AGENT_NO_AGENTS_MD)
      --platform <os>              Override the platform for plugin and tool gating (one of: macos, linux, windows, all;
                                   env: MINIMAL_AGENT_PLATFORM)
      --host-mode <id>             Hand the process to a plugin host mode, for example acp
    Session
      --session-id <uuid>  Pin the session id of this run (env: MINIMAL_AGENT_SESSION_ID)
    System prompt (override or omit individual system-prompt parts)
      --system-prompt <text>                   Replace the whole core-controllable system prompt (also
                                               --system-prompt-file <path>, --no-system-prompt; env:
                                               MINIMAL_AGENT_SYSTEM_PROMPT)
      --system-identity <text>                 Replace the neutral identity block (also --system-identity-file <path>,
                                               --no-system-identity; env: MINIMAL_AGENT_SYSTEM_IDENTITY)
      --system-instructions <text>             Replace the base instructions block (also --system-instructions-file
                                               <path>, --no-system-instructions; env: MINIMAL_AGENT_SYSTEM_INSTRUCTIONS)
      --system-loop-safety <text>              Replace the loop-safety paragraph (also --system-loop-safety-file <path>,
                                               --no-system-loop-safety; env: MINIMAL_AGENT_SYSTEM_LOOP_SAFETY)
      --system-tool-output-conventions <text>  Replace the tool-output-conventions paragraph (also
                                               --system-tool-output-conventions-file <path>,
                                               --no-system-tool-output-conventions; env:
                                               MINIMAL_AGENT_SYSTEM_TOOL_OUTPUT_CONVENTIONS)
      --system-session-context <text>          Replace the session-context block of plugin prompts (also
                                               --system-session-context-file <path>, --no-system-session-context; env:
                                               MINIMAL_AGENT_SYSTEM_SESSION_CONTEXT)
      --provider-system-preamble <text>        Replace the provider preamble, needs --unsafe-system-prompt-overrides
                                               (also --provider-system-preamble-file <path>,
                                               --no-provider-system-preamble; env:
                                               MINIMAL_AGENT_PROVIDER_SYSTEM_PREAMBLE)
      --unsafe-system-prompt-overrides         Allow a provider preamble override or omission
    Debug
      -d, --debug    Enable debug logging (env: DEBUG)
      -v, --verbose  Do not truncate debug output (env: VERBOSE)
      --skip-quota   Skip the startup quota check (env: MINIMAL_AGENT_SKIP_QUOTA)
    Help
      -h, --help  Show help

  ENVIRONMENT
    DEBUG                               Verbose request and response debug diagnostics (set to 1; flag: --debug)
    MINIMAL_AGENT_LOG_STDERR            Mirror every diagnostic to stderr (set to 1)
    MINIMAL_AGENT_TRANSPORT             Transport: http2 or fetch (default: http2)
    MINIMAL_AGENT_NO_PLAINTEXT_HTTP1    Keep http:// on HTTP/2, no plaintext auto-route (set to 1)
    MINIMAL_AGENT_ALLOW_FETCH_FALLBACK  Allow fetch fallback after HTTP/2 failure (set to 1)
    MINIMAL_AGENT_NET_DBG               Mirror raw HTTP traffic to ~/.minimal-agent/net-dbg/ (set to 1)
    CLAUDE_CODE_EXTRA_METADATA          JSON object merged into metadata.user_id
    MINIMAL_AGENT_SPINNER               Spinner preset id (flag: --spinner)
    MINIMAL_AGENT_EFFORT                Reasoning effort (flag: --effort)
    MINIMAL_AGENT_FAST                  Opt into fast-mode dispatch (set to 1; flag: --fast)
    MINIMAL_AGENT_THINKING_DISPLAY      Force the thinking display mode (flag: --thinking-display)
    MINIMAL_AGENT_FORMATTER_ARGS        Extra formatter args, shell-style (flag: --formatter-args)
    MINIMAL_AGENT_CONFIG                Override the config path (default: ~/.minimal-agent/config.jsonc)
    MINIMAL_AGENT_MODEL                 Default model id (flag: --model)
    MINIMAL_AGENT_PROVIDER              Default provider id (flag: --provider)
    MINIMAL_AGENT_ENDPOINT              Generic endpoint URL (flag: --endpoint)
    MINIMAL_AGENT_FORMAT                Generic endpoint surface id (flag: --format)
    MINIMAL_AGENT_AUTH_TYPE             Generic endpoint auth type (flag: --auth-type)
    MINIMAL_AGENT_API_KEY               Generic endpoint key or token (flag: --api-key)
    MINIMAL_AGENT_AUTH_HEADER           Custom auth header name (flag: --auth-header)
    MINIMAL_AGENT_PROVIDER_MODEL        Wire model id override (flag: --provider-model)
    MINIMAL_AGENT_EFFORT_LEVELS         Generic endpoint effort ladder, comma-separated (flag: --effort-levels)
    MINIMAL_AGENT_MEMORY_NAMESPACE      Namespace memory paths under namespaces/<ns>/
    MINIMAL_AGENT_THEME                 UI theme: dark, light, or high-contrast
    MINIMAL_AGENT_NO_LIVE_AREA          Disable the live-area REPL (set to 1)
    MINIMAL_AGENT_HEADER                Force the startup tree: 0 or 1 (flag: --header)
    MINIMAL_AGENT_MODE                  Initial mode id, or none (flag: --mode)
    MINIMAL_AGENT_CONTINUATION_PROMPT   Override the continuation-prompt prefix (default: "  ")
    MINIMAL_AGENT_SHOW_HIDDEN_CHARS     Show spaces, tabs, and newlines as faint glyphs (set to 1; flag:
                                        --show-hidden-chars)
    MINIMAL_AGENT_SKIP_QUOTA            Skip the startup quota check (set to 1; flag: --skip-quota)
    MINIMAL_AGENT_NO_PLUGIN_SYNC        Skip the first-run extended-plugins clone (set to 1)
    MINIMAL_AGENT_PLUGIN_SIBLINGS       Dev plugin checkout dirs, colon-separated
    MINIMAL_AGENT_AUTO_ASK              Turn off automatic ASK mode in the REPL (set to 0)
    MINIMAL_AGENT_AUTO_COMPACT          Turn off auto compact on a context overflow (set to 0)
    MINIMAL_AGENT_DISABLE_PLUGINS       Comma-separated plugin ids to skip this run (flag: --disable-plugin)
    MINIMAL_AGENT_ENABLE_PLUGINS        Comma-separated plugin ids to force on this run (flag: --enable-plugin)
    MINIMAL_AGENT_NO_AGENTS_MD          Skip AGENTS.md system-prompt injection (set to 1; flag: --no-agents-md)
    MINIMAL_AGENT_PLUGINS_REPO          Git URL of the extended plugins repo, for a fork or mirror
    MINIMAL_AGENT_GITHUB_TOKEN          Token to clone a private plugins repo, else GITHUB_TOKEN, GH_TOKEN, gh
    MINIMAL_AGENT_NO_HISTORY            Disable prompt history (set to 1)
    MINIMAL_AGENT_FILE_LOCK_DISABLED    Disable cooperative file locking (set to 1)
    MINIMAL_AGENT_SUBAGENT_MODEL        Force a model for spawned workers
    MINIMAL_AGENT_SUBAGENT_AUTO_TIER    Let specialists pick a per-role model (set to 1)
    MINIMAL_AGENT_SYSTEM_*              Override system-prompt parts, see the System prompt flags

  PLUGIN NOTES
    Enable and disable precedence: CLI → env → config → manifest.
    List              minimal-agent plugins list
    One-shot disable  minimal-agent --disable-plugin web-search -p "…"
    Disable many      minimal-agent --disable-plugin web-search,memory
    One-shot enable   minimal-agent --enable-plugin interleave-thinking
    Persistent        { "plugins": { "<id>": { "enabled": false } } }
    Opt in            { "plugins": { "<id>": { "enabled": true } } } (for plugins shipped disabled)
    Built-in          ask-mode, config, diff-view, env-info, file-lock,
                      history, memory, model-info, quota-status, schedule,
                      session-info, sub-agents, tasks, usage, web-search
    Disabled          interleave-thinking, security, minimal-agent-cloud (opt in to use, see Opt in above)

  LEARN MORE
    Use minimal-agent help <command> for command help.
    minimal-agent --help --json prints this help as JSON
    github.com/gastonmorixe/minimal-agent
    CHANGELOG.md                    CLI release notes, newest first (minimal-agent-cli repo)
    docs/tui/                       Terminal renderer architecture (compositor, live area, editor)
    core docs/CHANGELOG.md          Core release notes (minimal-agent-core repo)
    core docs/network/              HTTP transport, retry, and wire-capture notes
    core docs/sub-agents-prompt.md  How the sub-agents system prompt composes
    core docs/changes/              Per-change write-ups, dated
"
`;
